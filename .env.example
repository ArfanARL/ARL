POSTGRES_DB=agentic_research_labs
POSTGRES_USER=arl_app
POSTGRES_PASSWORD=replace-with-a-long-random-local-secret
POSTGRES_PORT=5432
REDIS_PORT=6379
CORE_API_PORT=8080
AI_SERVICE_TOKEN=replace-with-a-different-long-random-service-token
WEBSITE_ORIGIN=http://localhost:3000

# JWT signing secret: generate a unique random value of at least 32 bytes
JWT_SIGNING_KEY=replace-with-a-unique-random-secret-at-least-32-bytes
# Optional first-run administrator bootstrap (use only for initial local setup)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Browser-visible Core API base URL for Next.js admin pages
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
